-- Crea una etiqueta de UI con el texto 
local name = UI.Label("Tecnicas")

-- Define una macro que se ejecuta cada 800 milisegundos
macro(800, function()
  local rainbowDelay = 0 -- Inicializa el retraso del arco iris

  -- Itera sobre una lista de colores
  for k, color in ipairs({"#d90202", "#d9ca02", "#02d906", "#0283d9", "#7c02d9", "#02d9d9"}) do
    -- Programa una funciÃ³n que cambia el color de la etiqueta despuÃ©s de un retraso
    schedule(rainbowDelay, function()
      name:setColor(color) -- Establece el color de la etiqueta
    end)

    -- Incrementa el retraso para el prÃ³ximo color
    rainbowDelay = rainbowDelay + 100 -- Tiempo entre colores
  end
end, SpellsTab)

g_ui.loadUIFromString([[
ConfigWindow < MainWindow
  text: Todos
  size: 160 160

  HorizontalSeparator
    id: separator
    anchors.right: parent.right
    anchors.left: parent.left
    anchors.bottom: closeButton.top
    margin-bottom: 5

  Panel
    id: lista
    anchors.fill: parent
    anchors.bottom: closeButton.top
    layout:
      type: grid
      cell-size: 110 15
      cell-spacing: 2

  Button
    id: closeButton
    text: Cerrar
    font: cipsoftFont
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    size: 45 21
]])

local panelName = "configMacro"
if not storage[panelName] then
  storage[panelName] = {
    enabled = false,
  }
end

local config = storage[panelName]

local rootWidget = g_ui.getRootWidget()
local configWindow

configWindow = UI.createWindow('ConfigWindow', rootWidget)
configWindow:hide()

local listaMacros = {}

local lvl1 = macro(500, "Lvl1 Missiles", function()
    if g_game.isAttacking() then
        say("missiles")
    end
end)

local lvl25 = macro(500, "Lvl25 SupMiss", function()
    if g_game.isAttacking() then
        say("super missiles")
    end
end)

local lvl100 = macro(1000, "Lvl100 Expl", function()
    if g_game.isAttacking() then
        say("explosion")
    end
end)

		local lvl15k = macro(1000, "Lvl1k5 AltExpl", function()
    if g_game.isAttacking() then
        say("alternative explosion")
    end
end)

local lvl3k = macro(3000, "Lvl3k AltKame", function()
    if g_game.isAttacking() then
        say("alternative kamehameha")
    end
end)

table.insert(listaMacros, lvl1)
table.insert(listaMacros, lvl25)
table.insert(listaMacros, lvl100)
table.insert(listaMacros, lvl15k)
table.insert(listaMacros, lvl3k)

local checkboxes = {}

for _, mac in ipairs(listaMacros) do
    local checkbox = g_ui.createWidget("CheckBox", configWindow.lista)
    checkbox:setText(mac.switch:getText())
    checkbox.onCheckChange = function(wid, isChecked)
        mac.setOn(isChecked and config.enabled)
    end
    checkbox:setChecked(mac.isOn())
    mac.switch:setVisible(false)
    table.insert(checkboxes, checkbox)
end

configWindow.closeButton.onClick = function(widget)
    configWindow:hide()
end

UI.SwitchAndButton({on = config.enabled, left = "Para Todos", right = "MENU"}, function(widget)
    config.enabled = not config.enabled
    for i, mac in ipairs(listaMacros) do
        mac.setOn(config.enabled and checkboxes[i]:isChecked())
    end
end, function()
    configWindow:show()
    configWindow:raise()
    configWindow:focus()
end)


